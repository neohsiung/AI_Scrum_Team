# ===========================================
# Agent Scrum Team - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Claude API (from your Claude Team account)
CLAUDE_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# Redis (default works with docker-compose)
REDIS_URL=redis://localhost:6379/0

# SQLite memory storage
MEMORY_DB_PATH=./data/memory.db

# ------------------------------------------
# Telegram Bot Tokens
# Create 8 bots via @BotFather on Telegram
# Each agent gets its own bot/channel
# ------------------------------------------
TG_TOKEN_SCRUM_MASTER=
TG_TOKEN_PRODUCT_OWNER=
TG_TOKEN_TECH_LEAD=
TG_TOKEN_BACKEND=
TG_TOKEN_FRONTEND=
TG_TOKEN_APP=
TG_TOKEN_QA=
TG_TOKEN_DEVOPS=
TG_TOKEN_UIUX=
TG_TOKEN_HUMAN_PROXY=

# Your Telegram user chat ID (for escalation)
TG_OWNER_CHAT_ID=

# Consensus: max rounds before escalating to you
MAX_CONSENSUS_ROUNDS=3
